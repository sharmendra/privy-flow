# Placeholders only. Real local values are generated into git-ignored per-service files:
#   uv run scripts/gen_local_secrets.py --admin-url <admin database URL>
# Each service reads only its own file, so the two sections below never share a process.

# --- services/sanitization_service/.env ---
# Runtime role (least privilege), used by the running service.
PRIVYFLOW_SAN_DATABASE_URL=postgresql+psycopg://privyflow_runtime:CHANGE_ME@localhost:5432/privyflow
# Admin role, used only by Alembic and scripts/create_db_roles.py. The service never reads it.
PRIVYFLOW_SAN_MIGRATION_DATABASE_URL=postgresql+psycopg://ADMIN_USER:CHANGE_ME@localhost:5432/privyflow

# Settings admin role, used only by scripts/settings.py to write settings to the database.
PRIVYFLOW_SAN_SETTINGS_ADMIN_DATABASE_URL=postgresql+psycopg://privyflow_settings_admin:CHANGE_ME@localhost:5432/privyflow
# Vault and public API secrets, read by the running service only. Never put them in the
# settings file or database. `uv run scripts/gen_local_secrets.py` generates real local values.
# Public API keys by tenant (each at least 24 ASCII characters, none shared):
PRIVYFLOW_SAN_API_KEYS='{"tenant-demo-a": "CHANGE_ME_TO_A_RANDOM_KEY_OF_32_CHARS"}'
# Encryption keys by version, each a base64 AES-256 key (32 random bytes). New data is sealed
# with the active version; older versions stay listed so existing rows still decrypt.
PRIVYFLOW_SAN_ENCRYPTION_KEYS='{"1": "CHANGE_ME_BASE64_OF_32_RANDOM_BYTES"}'
PRIVYFLOW_SAN_ACTIVE_KEY_VERSION=1
# Server-side pepper for the restore-reference digest: base64 of at least 32 random bytes.
PRIVYFLOW_SAN_CREDENTIAL_PEPPER=CHANGE_ME_BASE64_OF_32_RANDOM_BYTES
# Secret the De-sanitization Service presents to the internal mapping API (X-Service-Secret).
# At least 32 printable ASCII characters, and different from every API key above. It must match
# PRIVYFLOW_DESAN_SERVICE_SECRET below.
PRIVYFLOW_SAN_SERVICE_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
# Where operational settings live: file (default) or db. Change it and restart the service.
# PRIVYFLOW_SETTINGS_BACKEND=file
# PRIVYFLOW_SETTINGS_FILE=config/settings.json   # copy config/settings.example.json first

# --- services/desanitization_service/.env ---
# This service has no database and must never be given one.
PRIVYFLOW_DESAN_SANITIZATION_BASE_URL=http://127.0.0.1:8001
# This service's own client API keys by tenant (each at least 24 ASCII characters, none shared,
# and different from the Sanitization Service keys). The tenant of a key is the tenant whose
# restore-references it may use.
PRIVYFLOW_DESAN_API_KEYS='{"tenant-demo-a": "CHANGE_ME_TO_ANOTHER_RANDOM_KEY_OF_32_CHARS"}'
# The same value as PRIVYFLOW_SAN_SERVICE_SECRET.
PRIVYFLOW_DESAN_SERVICE_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARS
# Optional limits. Defaults: request body 262144 bytes, restored text 1048576 bytes, internal
# call timeout 3 seconds.
# PRIVYFLOW_DESAN_MAX_REQUEST_BYTES=262144
# PRIVYFLOW_DESAN_MAX_OUTPUT_BYTES=1048576
# PRIVYFLOW_DESAN_INTERNAL_CLIENT_TIMEOUT_SECONDS=3

# --- tests only (shell environment, never a file) ---
# Admin URL of a local PostgreSQL, used instead of Docker. Tests create and drop their own
# pf_test_* databases and never touch the named database's data.
# PRIVYFLOW_TEST_DATABASE_URL=postgresql+psycopg://ADMIN_USER:CHANGE_ME@localhost:5432/privyflow
