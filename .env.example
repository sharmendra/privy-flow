# Placeholders only. Real local values are generated into git-ignored per-service files:
#   uv run scripts/gen_local_secrets.py --admin-url <admin database URL>
# Each service reads only its own file, so the two sections below never share a process.

# --- services/sanitization_service/.env ---
# Runtime role (least privilege), used by the running service.
PRIVYFLOW_SAN_DATABASE_URL=postgresql+psycopg://privyflow_runtime:CHANGE_ME@localhost:5432/privyflow
# Admin role, used only by Alembic and scripts/create_db_roles.py. The service never reads it.
PRIVYFLOW_SAN_MIGRATION_DATABASE_URL=postgresql+psycopg://ADMIN_USER:CHANGE_ME@localhost:5432/privyflow

# --- services/desanitization_service/.env ---
# This service has no database and must never be given one.
PRIVYFLOW_DESAN_SANITIZATION_BASE_URL=http://127.0.0.1:8001

# --- tests only (shell environment, never a file) ---
# Admin URL of a local PostgreSQL, used instead of Docker. Tests create and drop their own
# pf_test_* databases and never touch the named database's data.
# PRIVYFLOW_TEST_DATABASE_URL=postgresql+psycopg://ADMIN_USER:CHANGE_ME@localhost:5432/privyflow
