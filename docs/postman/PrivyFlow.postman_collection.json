    {
      "name": "2. Sanitization",
      "item": [
        {
          "name": "Policy for tenant A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"gdpr with a 3600 second lifetime\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().max_ttl_seconds).to.eql(3600);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{san_key_a}}"
              }
            ],
            "url": "{{san_url}}/api/v1/policies"
          }
        },
        {
          "name": "Sanitize the sample text (saves the reference)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"original\", \"Contact Alice at alice@example.com or +1 202-555-0143. Server 192.0.2.10 reported the issue.\");",
                  "pm.collectionVariables.set(\"scope\", \"scope-\" + Math.random().toString(16).slice(2, 8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test(\"three values masked, Alice kept\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(b.sanitized_text).to.eql(\"Contact Alice at [EMAIL_001] or [PHONE_001]. Server [IP_ADDRESS_001] reported the issue.\");",
                  "  pm.expect(b.entity_count).to.eql(3);",
                  "});",
                  "pm.test(\"reference is pf1_ plus 43 characters\", function () {",
                  "  pm.expect(b.restore_reference).to.match(/^pf1_[A-Za-z0-9_-]{43}$/);",
                  "});",
                  "pm.collectionVariables.set(\"ref\", b.restore_reference);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{san_key_a}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{san_url}}/api/v1/sanitizations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"{{original}}\",\n  \"request_scope_id\": \"{{scope}}\",\n  \"policy_id\": \"effective\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Repeated values share a placeholder",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"one placeholder for bob\", function () {",
                  "  pm.expect(pm.response.json().sanitized_text).to.eql(\"[EMAIL_001] wrote to [EMAIL_001] and [EMAIL_002]\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{san_key_a}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{san_url}}/api/v1/sanitizations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"bob@example.com wrote to bob@example.com and carol@example.com\",\n  \"request_scope_id\": \"{{scope}}-2\",\n  \"policy_id\": \"effective\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Nothing to mask",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"unchanged, no reference\", function () {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.sanitized_text).to.eql(\"Nothing sensitive here.\");",
                  "  pm.expect(b.restore_reference).to.eql(null);",
                  "  pm.expect(b.entity_count).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{san_key_a}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{san_url}}/api/v1/sanitizations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Nothing sensitive here.\",\n  \"request_scope_id\": \"{{scope}}-3\",\n  \"policy_id\": \"effective\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Literal placeholder in the input",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"literal kept, new value gets 002\", function () {",
                  "  pm.expect(pm.response.json().sanitized_text).to.eql(\"The code [EMAIL_001] is literal. Mail [EMAIL_002]\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{san_key_a}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{san_url}}/api/v1/sanitizations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"The code [EMAIL_001] is literal. Mail dave@example.com\",\n  \"request_scope_id\": \"{{scope}}-4\",\n  \"policy_id\": \"effective\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "3. Restoration",
      "item": [
        {
          "name": "Restore with the correct key, tenant and scope",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json();",
                  "pm.test(\"restored text equals the original\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(b.restored_text).to.eql(pm.collectionVariables.get(\"original\"));",
                  "  pm.expect(b.restored_count).to.eql(3);",
                  "  pm.expect(b.unmatched_placeholder_count).to.eql(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{desan_key_a}}"
