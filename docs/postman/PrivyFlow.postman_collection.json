{
  "info": {
    "name": "PrivyFlow manual tests",
    "description": "Runs the steps of docs/MANUAL_TEST.md. Import PrivyFlow.postman_environment.json, fill in the keys, select that environment, then run the collection in order with the Collection Runner. Folder 1 and 2 must run before the others: they save the restore reference.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "Sanitization live",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200 and ok\", function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql(\"ok\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{san_url}}/health/live"
          }
        },
        {
          "name": "Sanitization ready",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200 and ok\", function () {",
                  "  pm.response.to.have.status(200);",
