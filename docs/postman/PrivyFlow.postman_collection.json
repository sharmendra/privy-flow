              "mode": "raw",
              "raw": "{\n  \"sanitized_text\": \"Contact Alice at [EMAIL_001] or [PHONE_001]. Server [IP_ADDRESS_001] reported the issue.\",\n  \"restore_reference\": \"{{ref}}\",\n  \"request_scope_id\": \"{{scope}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Unknown and altered placeholders are left alone",
