              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"1 restored, 2 unmatched, rest untouched\", function () {",
                  "  const b = pm.response.json();",
                  "  pm.expect(b.restored_text).to.eql(\"alice@example.com [EMAIL_999] [EMAIL_0001] [email_001] [EMAIL_REDACTED]\");",
                  "  pm.expect(b.restored_count).to.eql(1);",
                  "  pm.expect(b.unmatched_placeholder_count).to.eql(2);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{desan_key_a}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{desan_url}}/api/v1/desanitizations",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sanitized_text\": \"[EMAIL_001] [EMAIL_999] [EMAIL_0001] [email_001] [EMAIL_REDACTED]\",\n  \"restore_reference\": \"{{ref}}\",\n  \"request_scope_id\": \"{{scope}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Reuse within the lifetime",
